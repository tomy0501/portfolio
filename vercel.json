{
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "https://authorizeservice.onrender.com/:path*"
    },
    {
        "source": "/api/:path*",
        "destination": "https://goapp-84ab.onrender.com/:path*"
    },
    {
      "source": "/((?!api/|auth/).*)",
      "destination": "/index.html"
    }
  ]
}